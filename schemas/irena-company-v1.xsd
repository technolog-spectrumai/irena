<?xml version="1.0" encoding="UTF-8"?>
<!--
  Irena company bodies, version 1.

  Two elements a company puts on its ledger, each carried by an <irena-record>
  (irena-record-v1.xsd) or read on its own:

    <company-genesis>    the whole company as founded: <identity>, an optional
                         <incorporation>, the initial <share-structure> and <governance>
                         wrapping <decision-channels>. One document founds a company;
                         later records amend one part of it each.
    <identity>           who the company is: name, jurisdiction, registration.
    <share-structure>    the share register. FLAT SHARES: every share is one vote, so a
                         holder is a holding and one element carries both. There are no
                         share classes in version 1; when they arrive they are a new
                         version of this body, not an attribute added to it.
    <decision-channels>  who may decide, and how. Each <channel> has an id, an actor
                         source and a mode:

                           source="share-register"  the holders of the register in
                                                    force when a decision is frozen;
                                                    weight = shares
                           source="roster"          the <member>s listed inline, each
                                                    with a declared weight (default 1)
                           mode="individual"        one actor signs; the source must
                                                    resolve to exactly one actor
                           mode="collective"        the actors form a Bornite electorate
                                                    decided by the nested <voting-rules>

                         "shareholders", "board", "ceo" are configurations, never types:
                         nothing here names an organ or a legal system, and Irena does
                         not decide whether the configured authority is legally correct.
                         Notarisation is the trust boundary. A channel says nothing about
                         WHAT its actors may decide; scoping is not in version 1.

  The register carries each holder's signing key. That is what lets a vote check that
  a ballot came from a registered holder: keys are company data, on the chain, amended
  through the same chain as everything else. A holder without a key owns their shares
  and counts towards quorum but cannot cast a ballot.

  Constraints XSD 1.0 cannot express are enforced by the reader: holder ids unique,
  signing keys unique across holders, shares at least one, total shares within u64;
  channel ids unique, at least one channel, member ids and keys unique within a roster,
  weights at least one, a roster non-empty, <member>s only under source="roster",
  <voting-rules> present exactly when mode="collective".
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:include schemaLocation="bornite-common-v1.xsd"/>
  <xs:include schemaLocation="bornite-voting-rules-v1.xsd"/>

  <!-- A 32-byte digest or Ed25519 public key as 64 lowercase hex characters. -->
  <xs:simpleType name="Hex32">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{64}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyText">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Identity">
    <xs:attribute name="name" type="NonEmptyText" use="required"/>
    <!-- Free text in whatever form the notary uses: gb, us-de, Delaware. -->
    <xs:attribute name="jurisdiction" type="xs:string" use="optional"/>
    <xs:attribute name="registered-number" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- The active governance configuration: the channel set. -->
  <xs:complexType name="Governance">
    <xs:sequence>
      <xs:element name="decision-channels" type="DecisionChannels" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- An opaque label naming a channel. Same grammar as a company id. -->
  <xs:simpleType name="ChannelId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9._\-]{0,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ChannelMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="individual"/>
      <xs:enumeration value="collective"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActorSource">
    <xs:restriction base="xs:string">
      <xs:enumeration value="share-register"/>
      <xs:enumeration value="roster"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Member">
    <!-- Also the member's Bornite voter id: same grammar, no translation. -->
    <xs:attribute name="id" type="VoterId" use="required"/>
    <!-- Ed25519 public key the member signs with. Absent: cannot sign. -->
    <xs:attribute name="key" type="Hex32" use="optional"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <!-- At least one; the reader refuses zero. Default 1. -->
    <xs:attribute name="weight" type="xs:unsignedLong" use="optional" default="1"/>
  </xs:complexType>

  <!-- Empty for the share register; <member>s for a roster (enforced by the reader). -->
  <xs:complexType name="Actors">
    <xs:sequence>
      <xs:element name="member" type="Member" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="source" type="ActorSource" use="required"/>
  </xs:complexType>

  <!-- <voting-rules> exactly when mode="collective" (enforced by the reader). -->
  <xs:complexType name="Channel">
    <xs:sequence>
      <xs:element name="actors" type="Actors" minOccurs="1" maxOccurs="1"/>
      <xs:element name="voting-rules" type="VotingRules" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="id" type="ChannelId" use="required"/>
    <xs:attribute name="mode" type="ChannelMode" use="required"/>
  </xs:complexType>

  <xs:complexType name="DecisionChannels">
    <xs:sequence>
      <xs:element name="channel" type="Channel" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CompanyGenesis">
    <xs:sequence>
      <xs:element name="identity" type="Identity" minOccurs="1" maxOccurs="1"/>
      <xs:element name="incorporation" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <!-- Digest of the certificate of incorporation or equivalent. Opaque. -->
          <xs:attribute name="document-digest" type="Hex32" use="optional"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="share-structure" type="ShareStructure" minOccurs="1" maxOccurs="1"/>
      <xs:element name="governance" type="Governance" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ShareStructure">
    <xs:sequence>
      <xs:element name="holder" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <!-- Also the holder's Bornite voter id: same grammar, no translation. -->
          <xs:attribute name="id" type="VoterId" use="required"/>
          <!-- Ed25519 public key the holder signs ballots with. Absent: cannot vote. -->
          <xs:attribute name="key" type="Hex32" use="optional"/>
          <xs:attribute name="name" type="xs:string" use="optional"/>
          <!-- At least one; the reader refuses zero. -->
          <xs:attribute name="shares" type="xs:unsignedLong" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="company-genesis" type="CompanyGenesis"/>
  <xs:element name="identity" type="Identity"/>
  <xs:element name="share-structure" type="ShareStructure"/>
  <xs:element name="decision-channels" type="DecisionChannels"/>

</xs:schema>
