<?xml version="1.0" encoding="UTF-8"?>
<!--
  A single-member company. Its one channel takes its actors from the share register
  and decides in individual mode: the source resolves to exactly one holder, so the
  sole member signs decisions alone. No "sole director" type is involved.

  The day a second holder is admitted, this channel stops resolving (two actors in
  individual mode) until the channel set is amended - Irena reports it, never guesses.

  Ada is also the only person who may sign record transactions, for both families:
  in a one-person company the member, the secretary and the notary's hand are one.
-->
<company-genesis>
  <identity name="Ada Lovelace Consulting Ltd" jurisdiction="gb" registered-number="07654321"/>
  <share-structure>
    <holder id="ada" name="Ada Lovelace" shares="1"/>
  </share-structure>
  <identities>
    <person id="ada" name="Ada Lovelace" key="ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c"/>
  </identities>
  <governance>
    <decision-channels>
      <channel id="owner" mode="individual">
        <actors source="share-register"/>
        <scope>
          <amend part="identity"/>
          <amend part="share-structure"/>
          <amend part="decision-channels"/>
          <amend part="identities"/>
          <amend part="authorisation"/>
        </scope>
      </channel>
    </decision-channels>
  </governance>
  <authorisation>
    <signer person="ada" records="company"/>
    <signer person="ada" records="governance"/>
  </authorisation>
</company-genesis>
