<?xml version="1.0" encoding="UTF-8"?>
<!--
  A channel set with a weighted committee beside the shareholders and the board. The
  committee is a roster with unequal weights and a two-thirds threshold: the
  mode/source split covers it with no committee type in Rust. Because the channel set
  is replaced whole, an amendment lists every channel that should exist afterwards -
  this one is what the board of genesis-three-channels.xml adopts in the documentation
  drill, after the ceo channel has abolished itself.
-->
<decision-channels>
  <channel id="shareholders" mode="collective">
    <!-- Every holder of the register in force when a decision is frozen; one share,
         one vote. Bornite's rules, unchanged. -->
    <actors source="share-register"/>
    <voting-rules version="1.0">
      <weight type="electorate"/>
      <exclusions enabled="true"/>
      <quorum type="fraction" numerator="1" denominator="2" basis="total-electorate"/>
      <threshold type="simple-majority" basis="votes-cast"/>
      <abstentions treatment="exclude"/>
      <tie treatment="reject"/>
    </voting-rules>
  </channel>
  <channel id="board" mode="collective">
    <!-- A roster listed inline. The chair carries weight 2; weight defaults to 1.
         Vance has registered no key: counted in the electorate, unable to sign. -->
    <actors source="roster">
      <member id="chen" key="ca93ac1705187071d67b83c7ff0efe8108e8ec4530575d7726879333dbdabe7c" name="M. Chen" weight="2"/>
      <member id="okafor" key="6e7a1cdd29b0b78fd13af4c5598feff4ef2a97166e3ca6f2e4fbfccd80505bf1" name="A. Okafor"/>
      <member id="vance" name="R. Vance"/>
    </actors>
    <voting-rules version="1.0">
      <weight type="electorate"/>
      <exclusions enabled="false"/>
      <quorum type="none"/>
      <threshold type="simple-majority" basis="votes-cast"/>
      <abstentions treatment="exclude"/>
      <tie treatment="reject"/>
    </voting-rules>
  </channel>
  <channel id="audit-committee" mode="collective">
    <actors source="roster">
      <member id="okafor" key="6e7a1cdd29b0b78fd13af4c5598feff4ef2a97166e3ca6f2e4fbfccd80505bf1" name="A. Okafor" weight="3"/>
      <member id="vance" key="8a875fff1eb38451577acd5afee405456568dd7c89e090863a0557bc7af49f17" name="R. Vance" weight="2"/>
      <member id="quinn" key="1398f62c6d1a457c51ba6a4b5f3dbd2f69fca93216218dc8997e416bd17d93ca" name="S. Quinn" weight="1"/>
    </actors>
    <voting-rules version="1.0">
      <weight type="electorate"/>
      <exclusions enabled="false"/>
      <quorum type="fraction" numerator="2" denominator="3" basis="total-electorate"/>
      <threshold type="fraction" numerator="2" denominator="3" basis="votes-cast"/>
      <abstentions treatment="exclude"/>
      <tie treatment="reject"/>
    </voting-rules>
  </channel>
</decision-channels>
