<?xml version="1.0" encoding="UTF-8"?>
<!--
  An authorisation amendment for genesis-three-channels.xml: okafor joins jane as a
  company signer, and alice may sign governance records (convene meetings, finalize
  votes) without being able to publish amendments. The authorisation is replaced whole.

  Two rules guard this record. The reader refuses any authorisation with no "company"
  row, and the ledger refuses one that leaves no company signer holding a key: the
  lockout rule, so a company can never lose the ability to amend itself. And on an
  individual decision the signer may not gain a row: the ceo channel (chen) could
  execute this amendment only if chen appeared in it no more than before.
-->
<authorisation>
  <signer person="jane" records="company"/>
  <signer person="jane" records="governance"/>
  <signer person="okafor" records="company"/>
  <signer person="alice" records="governance"/>
</authorisation>
