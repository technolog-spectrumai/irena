<?xml version="1.0" encoding="UTF-8"?>
<!--
  A channel-set amendment the "ceo" channel of genesis-three-channels.xml may NOT
  execute by its own individual decision. The sole actor (chen) sits on the board,
  and this document removes the other two directors: a seat chen keeps has changed,
  so the self-demotion rule refuses it (execution reports SelfPromotion, and a chain
  reader's verification names the SelfDemotionHolds check). The same document is a
  perfectly good amendment when the shareholders or the board itself carry it.
-->
<decision-channels>
  <channel id="shareholders" mode="collective">
        <!-- Every holder of the register in force when a decision is frozen; one share,
             one vote. Bornite's rules, unchanged. -->
        <actors source="share-register"/>
        <voting-rules version="1.0">
          <weight type="electorate"/>
          <exclusions enabled="true"/>
          <quorum type="fraction" numerator="1" denominator="2" basis="total-electorate"/>
          <threshold type="simple-majority" basis="votes-cast"/>
          <abstentions treatment="exclude"/>
          <tie treatment="reject"/>
        </voting-rules>
      </channel>
  <channel id="board" mode="collective">
    <actors source="roster">
      <member id="chen" name="M. Chen" weight="2"/>
    </actors>
    <voting-rules version="1.0">
      <weight type="electorate"/>
      <exclusions enabled="false"/>
      <quorum type="none"/>
      <threshold type="simple-majority" basis="votes-cast"/>
      <abstentions treatment="exclude"/>
      <tie treatment="reject"/>
    </voting-rules>
  </channel>
  <channel id="ceo" mode="individual">
        <!-- One actor signs. The source must resolve to exactly one actor. -->
        <actors source="roster">
          <member id="chen" name="M. Chen"/>
        </actors>
      </channel>
</decision-channels>
