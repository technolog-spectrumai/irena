<?xml version="1.0" encoding="UTF-8"?>
<!--
  A company founded with three decision channels, all through one implementation:

    shareholders  share register, collective   the holders vote, weight = shares
    board         roster, collective           three directors vote, weighted
    ceo           roster, individual           one director signs

  Nothing here names an organ or a legal system: "board" and "ceo" are labels the
  notary chose. Irena knows share-register, roster, individual and collective.

  Signing keys are Ed25519 public keys. These were derived from the seeds
  [1;32] (alice), [2;32] (bob), [4;32] (chen), [5;32] (okafor) so the documentation
  drill can sign with them; a real company registers its holders' and directors'
  own keys.
-->
<company-genesis>
  <identity name="Acme Industries Ltd" jurisdiction="gb" registered-number="01234567"/>
  <incorporation document-digest="9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f"/>
  <share-structure>
    <holder id="alice" key="8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" name="Alice Smith" shares="500"/>
    <holder id="bob" key="8139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" name="Bob Jones" shares="300"/>
    <holder id="carol" name="Carol White" shares="200"/>
  </share-structure>
  <governance>
    <decision-channels>
      <channel id="shareholders" mode="collective">
          <!-- Every holder of the register in force when a decision is frozen; one share,
               one vote. Bornite's rules, unchanged. -->
          <actors source="share-register"/>
          <voting-rules version="1.0">
            <weight type="electorate"/>
            <exclusions enabled="true"/>
            <quorum type="fraction" numerator="1" denominator="2" basis="total-electorate"/>
            <threshold type="simple-majority" basis="votes-cast"/>
            <abstentions treatment="exclude"/>
            <tie treatment="reject"/>
          </voting-rules>
        </channel>
      <channel id="board" mode="collective">
          <!-- A roster listed inline. The chair carries weight 2; weight defaults to 1.
               Vance has registered no key: counted in the electorate, unable to sign. -->
          <actors source="roster">
            <member id="chen" key="ca93ac1705187071d67b83c7ff0efe8108e8ec4530575d7726879333dbdabe7c" name="M. Chen" weight="2"/>
            <member id="okafor" key="6e7a1cdd29b0b78fd13af4c5598feff4ef2a97166e3ca6f2e4fbfccd80505bf1" name="A. Okafor"/>
            <member id="vance" name="R. Vance"/>
          </actors>
          <voting-rules version="1.0">
            <weight type="electorate"/>
            <exclusions enabled="false"/>
            <quorum type="none"/>
            <threshold type="simple-majority" basis="votes-cast"/>
            <abstentions treatment="exclude"/>
            <tie treatment="reject"/>
          </voting-rules>
        </channel>
      <channel id="ceo" mode="individual">
          <!-- One actor signs. The source must resolve to exactly one actor. -->
          <actors source="roster">
            <member id="chen" key="ca93ac1705187071d67b83c7ff0efe8108e8ec4530575d7726879333dbdabe7c" name="M. Chen"/>
          </actors>
        </channel>
    </decision-channels>
  </governance>
</company-genesis>
